#include<stdio.h>
int main()
{
    char dir;
    scanf("%c", &dir);
    switch(dir)
    {
        case'n':
        case'N':
        printf("North");
        break;
        case's':
        case'S':
        printf("South");
        break;
        
        case'E':
        case'e':
        printf("East");
        break;
        
        case'W':
        case'w':
        printf("West");
        break;
        
        default:
        {
            printf("Invalid input");
        }
    }
}
