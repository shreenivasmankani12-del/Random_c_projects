#include<stdio.h>
int main()
{
    int i,j,n,size;
    scanf("%d", &size);
    int arr[size];
    for(i=0;i<size;i++)
    {
        scanf("%d", &arr[i]);
    }
    printf("Elements before reversing\n");
    for(i=0;i<size;i++)
    {
        printf("%d ", arr[i]);
    }
    printf("\n");
    printf("Elements after reversing\n");
    for(i=0;i<size;i++)
    {
        printf("%d ", arr[size-i-1]);
    }
    
}
