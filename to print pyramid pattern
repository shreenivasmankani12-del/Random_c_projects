#include <stdio.h>
int main()
{
    int i,j,n,c;
    scanf("%d", &n);
    for(i=1;i<=n;i++)
    {
        c=n-i+1;
        for(j=1;j<=i;j++)
        {
            printf("%d ",c);
            c+=1;
        }

        printf("\n");
    }
    for(i=1;i<=n-1;i++)
    {
        c=i+1;
        for(j=1;j<=n-i;j++)
        {
            printf("%d ",c);
            c+=1;
        }
        printf("\n");
    }
}
