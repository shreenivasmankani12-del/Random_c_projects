#include<stdio.h>
#include<math.h>
int main()
{
    int num,i,flag;
    scanf("%d", &num);
    flag=0;
    if(num>0)
    {
        for(i=2;i<=(sqrt(num));i++)
        {
            if(num%i==0)
            {
                printf("%d is not a prime number", num);
                flag=1;
                break;
            }
        }
        if(flag==0)
        {
            printf("%d is a prime number",num);
        }
    }
    else
    {
        printf("Invalid input");
    }
}
