#include<stdio.h>
int main()
{
    int Time;
    scanf("%d", &Time);
    if (Time>5 && Time<11)
    {
        printf("Good morning");
    }
    else if (Time>12 && Time<15)
    {
        printf("Good afternoon");
    }
    else if (Time>16 && Time<21)
    {
        printf("Good evening");
    }
    else if (Time>22 && Time<=23 || Time>1 && Time<4)
    {
        printf("Good night");
    }
    else 
    {
        printf("Invalid hour");
    }
    
}
