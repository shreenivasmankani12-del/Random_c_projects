#include<stdio.h>
int main()
{
    int i,j,c,size,max;
    scanf("%d", &size);
    int arr[size];
    for(i=0;i<size;i++)
    {
        scanf("%d", &arr[i]);
    }
    max=arr[0];
    for(i=0;i<size;i++)
    {
        if(arr[i]>max)
        {
            max=arr[i];
        }
    }
    printf("Largest element is :%d", max);
}
