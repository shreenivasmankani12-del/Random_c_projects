#include<stdio.h>
void copy(char* ptr1,char* ptr2)
{
    int i=0,j;
    while(*(ptr2+i)!='\0')
    {
        *(ptr1+i)=*(ptr2+i);
        i++;
    }
    *(ptr1+i+1)='\0';
    printf("Copied string is ");
    for(j=0;j<i;j++)
    {
        printf("%c",*(ptr1+j));
    }
}
int main()
{
    char str1[100];
    char str2[100];
    fgets(str2,100,stdin);
    char* ptr1 = str1;
    char* ptr2 = str2;
    copy(ptr1,ptr2);
}
