#include<stdio.h>
#include<math.h>
int main()
{
    int num, revnum, digit, count, ep;
    scanf("%d", &num);
    count=log10(num)+1;
    digit=0;
    revnum=0;
    ep=0;
    if(num>=0)
    {
        while(count>0)
        {
            digit=num%10;
            num=num/10;
            revnum=(revnum*10)+digit;
            count-=1;
        }
    printf("Reversed number is %d",revnum);
    }
    else
    {
        printf("Please enter a positive integer");
    }
}
