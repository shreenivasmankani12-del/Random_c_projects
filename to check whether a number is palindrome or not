#include<stdio.h>
#include<math.h>
int main()
{
    int num,revnum,digit,i,count,w;
    scanf("%d", &num);
    w=num;
    count=log10(num)+1;
    revnum=0;
    for(i=1;i<=count;i++)
    {
        digit=num%10;
        num=num/10;
        revnum=revnum+digit;
        if(i!=count)
        {
            revnum=revnum*10;
        }
    }
    if(w==revnum)
    {
        printf("The entered number is an palindrome");
    }
    else
    {
        printf("The entered number is not an palindrome.");
    }
}
