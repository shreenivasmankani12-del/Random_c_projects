#include <stdio.h>

int is_prime(int num)
{
    int i,flag = 0;
    if(num>0)
    {
        for(i=2;i<=num/2;i++)
        {
            if(num%i==0)
            {
                flag = 1;
            }
        }
        if(flag == 0)
        {
            return 1;
        }
        else
        {
            return 0;
        }
    }
}

int main()
{
    int num;
    scanf("%d",&num);
    if(is_prime(num)==1)
    {
        printf("%d is a prime number",num);
    }
    else
    {
        if(num>0)
        {
            printf("%d is not a prime number",num);
        }
        else
        {
            printf("Invalid input");
        }
    }
    return 0;
}
