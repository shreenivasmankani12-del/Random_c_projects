#include<stdio.h>
int main()
{
    int limit,flag,i,j;
    scanf("%d",&limit);
    printf("2, ");
    for(i=2;i<=limit;i++)
    {
        for(j=2;j<i;j++)
        {
            
            if(i%j==0)
            {
                flag=0;
                break;
            }
            else
            {
                flag=1;
            }
        }
        if(flag==1)
        {
            printf("%d, ",i);
        }
    }
}
