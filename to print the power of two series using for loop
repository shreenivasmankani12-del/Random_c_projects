#include<stdio.h>
#include<math.h>
int main()
{
    int power,i;
    i=0;
    scanf("%d", &power);
    if(power>0)
    {
        while(i<power)
        {
            printf("%d ",(int)pow(2,i));
            i+=1;
        }
    }
    else
    {
        printf("Error : Number should be an positive number");
    }
}
