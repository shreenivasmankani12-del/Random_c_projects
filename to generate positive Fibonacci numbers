#include <stdio.h>

int main() {
    int n;
    
    printf("Enter a number: ");
    
    if (scanf("%d", &n) != 1 || n < 0) {
        printf("Invalid input\n");
        return 1;
    }
    
    int first = 0, second = 1, next = 0;
    
    while (next <= n) {
        printf("%d ", next);
        
        if (n == 0) {
            break;
        }
        
        first = second;
        second = next;
        next = first + second;
    }
    
    printf("\n");
    return 0;
}
