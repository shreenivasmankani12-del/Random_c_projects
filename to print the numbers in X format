#include<stdio.h>
int main()
{
    int n,l,i,j;
    scanf("%d", &n);
    for(i=1;i<=n;i++)
    {
        for(j=1;j<=n;j++)
        {
            if(i==j)
            {
                printf("%d",i);
            }
            else if((i+j-1)==n)
            {
                printf("%d",(n-i+1));
            }
            else
            {
                printf(" ");
            }
        }
        printf("\n");
        
    }
}
