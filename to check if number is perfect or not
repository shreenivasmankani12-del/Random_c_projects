#include<stdio.h>
int main()
{
    int num,sum,i;
    scanf("%d", &num);
    sum=0;
    if(num>0)
    {
        for(i=2;i<=(num/2);i++)
        {
            if(num%i==0)
            {
                sum+=i;
            }
        }
        sum+=1;
        if(sum==num && num!=1)
        {
            printf("Yes, entered number is perfect number");
        }
        else
        {
            printf("No, entered number is not a perfect number");
        }
    }
    else
    {
        printf("Error : Invalid Input, Enter only positive number");
    }
}
