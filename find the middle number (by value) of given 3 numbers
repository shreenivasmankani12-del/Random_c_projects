#include<stdio.h>
#include<math.h>
int main()
{
    int n1, n2, n3, min, max, mid;
    scanf("%d %d %d", &n1, &n2, &n3);
    min=n1;
    if (n2<min)
    {
        min=n2;
    }
    if (n3<min)
    {
        min=n3;
    }
    max=n1;
    if (n2>max)
    {
        max=n2;
    }
    if (n3>max)
    {
        max=n3;
    }
    if (n1!=min && n1!=max)
    {
        mid=n1;
    }
    else if (n2!=min && n2!=max)
    {
        mid=n2;
    }
    else
    {
        mid=n3;
    }
    printf("The middle number is %d", mid);
}
