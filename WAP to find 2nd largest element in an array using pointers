#include <stdio.h>

int sec_largest(int arr[], int size)
{
    int max1,max2,i;
    max1=arr[1];
    for(i=0;i<size;i++)
    {
        if(arr[i]>max1)
        {
            max1=arr[i];
        }
    }
    for(i=0;i<size;i++)
    {
        if((arr[i]>max2)&&(arr[i]!=max1))
        {
            max2=arr[i];
        }
    }
    return max2;
}

int main()
{
    int size,ret,i;
    scanf("%d", &size);
    int arr[size];
    for(i=0;i<size;i++)
    {
        scanf("%d",&arr[i]);
    }
    ret=sec_largest(arr, size);
    printf("Second largest element of the array is %d",ret);
}
