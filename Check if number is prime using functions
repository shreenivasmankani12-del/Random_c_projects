#include<stdio.h>
void checkprime(int num)
{
    int i,flag;
    flag=0;
    for(i=2;i<num/2;i++)
    {
        if(num%i==0)
        {
            flag=1;
            break;
        }
    }
    if(flag==0)
    {
        printf("%d is a prime number",num);
    }
    else
    {
        printf("%d is not a prime number",num);
    }
}
int main()
{
    int num;
    scanf("%d",&num);
    checkprime(num);
}
