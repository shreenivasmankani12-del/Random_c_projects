#include<stdio.h>
int main()
{
    int lines,i,j,count,space;
    scanf("%d", &lines);
    space=lines-1;
    for(i=1;i<=lines;i++)
    {
        for(j=1;j<=i;j++)
        {
            if(j<=space)
            {
                printf(" ");
            }
            else
            {
                printf("*");
            }
            space--;
        }
        printf("\n");
    }
}
