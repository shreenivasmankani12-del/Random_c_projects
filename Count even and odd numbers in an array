#include<stdio.h>
int main()
{
    int i,even,odd;
    int size;
    scanf("%d", &size);
    int arr[size];
    even=0;
    odd=0;
    for(i=0;i<size;i++)
    {
        scanf("%d",&arr[i]);
    }
    for(i=0;i<size;i++)
    {
        if(arr[i]%2==0)
        {
           even+=1; 
        }
        else
        {
            odd+=1; 
        }
    }
    printf("Even count: %d\n", even);
    printf("Odd count: %d", odd);
}
