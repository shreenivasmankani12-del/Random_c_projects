#include <stdio.h>
int square(int*ptr,int size)
{
    int i;
    printf("Square is ");
    for(i=0;i<size;i++)
    {
        printf("%d ",(*(ptr+i)*(*(ptr+i))));
    }
}
int main()
{
    int size,i;
    scanf("%d",&size);
    int arr[size];
    int*ptr=arr;
    for(i=0;i<size;i++)
    {
        scanf("%d",&arr[i]);
    }
    square(ptr,size);
}
