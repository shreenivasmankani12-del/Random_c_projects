#include<stdio.h>
int main()
{
    int size;
    scanf("%d",&size);
    int i,arr[size];
    for(i=0;i<size;i++)
    {
        scanf("%d",&arr[i]);
    }
    int* ptr=arr;
    float sum=0;
    for(i=0;i<size;i++)
    {
        sum+=*(ptr+i);
    }
    float avg=sum/size;
    printf("Average is %g",avg);
}
