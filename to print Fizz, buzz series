#include<stdio.h>
int main()
{
    int num;
    num=1;
    while (num<=100)
    {
        if (num%3==0)
        {
            if (num%5==0)
            {
                printf("FizzBuzz ");
            }
            else
            {
                printf("Fizz ");
            }
        }
        else if (num%5==0)
        {
            printf("Buzz ");
        }
        else
        {
            printf("%d ", num);
        }
        num+=1;
        
    }
}
