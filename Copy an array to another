#include<stdio.h>
int main()
{
    int i,j,n,size;
    scanf("%d", &size);
    int arr1[size],arr2[size];
    for(i=0;i<size;i++)
    {
        scanf("%d", &arr1[i]);
    }
    for(i=0;i<size;i++)
    {
        arr2[i]=arr1[i];
    }
    printf("Array1 elements: ");
    for(i=0;i<size;i++)
    {
        printf("%d ", arr1[i]);
    }
    printf("\n");
    printf("Array2 elements: ");
    for(i=0;i<size;i++)
    {
        printf("%d ", arr2[i]);
    }
}
