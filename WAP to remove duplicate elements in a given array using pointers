#include <stdio.h>

void fun(int arr1[], int size, int arr2[])
{
    int i,j,count=0,flag=0;
    for(i=0;i<size;i++)
    {
        for(j=0;j<count;j++)
        {
            if(arr1[i]==arr2[j])
            {
                flag = 1;
                break;
            }
        }
        if(flag==0)
        {
            arr2[count] = arr1[i];
            count++;
        }
    }
    printf("After removing duplicates: ");
    for(i=0;i<count;i++)
    {
        printf("%d ",arr2[i]);
    }
}

int main()
{
    int i,size;
    scanf("%d",&size);
    int arr1[size],arr2[size];
    for(i=0;i<size;i++)
    {
        scanf("%d",&arr1[i]);
    }
    fun(arr1,size,arr2);
}
